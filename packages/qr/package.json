    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
