{
  "name": "@ghostwire/transport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webrtc": {
      "types": "./dist/webrtc.d.ts",
      "import": "./dist/webrtc.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@ghostwire/crypto": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"no lint configured for @ghostwire/transport\"",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "ws": "^8.18.0"
  }
}
